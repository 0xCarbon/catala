; Dates in the JSON output of the interpreter and of every backend, in the
; form Catala reads back: years beyond 0-9999 included.

(rule
 (alias runtest)
 (deps
  run.sh
  far_dates.catala_en
  (package catala))
 (action
  (run sh run.sh interpret)))

(rule
 (alias runtest)
 (deps
  run.sh
  far_dates.catala_en
  (package catala))
 (action
  (run sh run.sh ocaml)))

(rule
 (alias runtest)
 (enabled_if %{bin-available:cc})
 (deps
  run.sh
  far_dates.catala_en
  (package catala))
 (action
  (run sh run.sh c)))

(rule
 (alias runtest)
 (enabled_if %{bin-available:javac})
 (deps
  run.sh
  far_dates.catala_en
  (package catala))
 (action
  (run sh run.sh java)))

(rule
 (alias runtest)
 (enabled_if %{bin-available:python3})
 (deps
  run.sh
  far_dates.catala_en
  (package catala))
 (action
  (run sh run.sh python)))
