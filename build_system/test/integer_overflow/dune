; Each backend reports duration arithmetic beyond its machine integers.
; Java cannot represent the components of Sum64 (overflow64.catala_en).

(rule
 (alias runtest)
 (deps
  run.sh
  overflow.catala_en
  overflow64.catala_en
  (package catala))
 (action
  (run
   sh
   run.sh
   overflow.catala_en
   ocaml
   Mult
   123
   "an integer is too large for this computation")))

(rule
 (alias runtest)
 (enabled_if %{bin-available:cc})
 (deps
  run.sh
  overflow.catala_en
  overflow64.catala_en
  (package catala))
 (action
  (run
   sh
   run.sh
   overflow.catala_en
   c
   Mult
   123
   "An integer is too large for this computation")))

(rule
 (alias runtest)
 (enabled_if %{bin-available:javac})
 (deps
  run.sh
  overflow.catala_en
  overflow64.catala_en
  (package catala))
 (action
  (run
   sh
   run.sh
   overflow.catala_en
   java
   Mult
   123
   "an integer is too large for this computation")))

(rule
 (alias runtest)
 (enabled_if %{bin-available:python3})
 (deps
  run.sh
  overflow.catala_en
  overflow64.catala_en
  (package catala))
 (action
  (run
   sh
   run.sh
   overflow.catala_en
   python
   Mult
   0
   "18446744073709551614 days")))

