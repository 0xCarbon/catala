│
│  Failed to validate JSON:
│    Missing object field departure
│  
│  Expected JSON object of the form:
│    { "arrival": $date,
│      "departure": $date }
│    $date:
│      /* Catala date */
│      /^(?!-0000-)-?([0-9]{4}|[1-9][0-9]{4,})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/
│      /* Accepts strings with the following format: YYYY-MM-DD, e.g.,
│         "1970-01-31", the year having more digits beyond 9999 and a minus
│         sign before 0 ("-0738-02-03") */
│      | { /* Accepts date objects: {"year":<int>, "month":<int>,
│             "day":<int>} */
│          "year": $integer,
│          "month": integer ∈ [1, 12],
│          "day": integer ∈ [1, 31] }
│    $integer:
│      /* Catala Integer */
│      integer | /^-?[0-9]+$/
│
├─➤ tests/json/bad/literal.catala_en:10.65-69:
