; Each backend reports a duration product beyond its machine integers

(rule
 (alias runtest)
 (deps
  run.sh
  overflow.catala_en
  (package catala))
 (action
  (run sh run.sh ocaml 123 "an integer is too large for this computation")))

(rule
 (alias runtest)
 (enabled_if %{bin-available:cc})
 (deps
  run.sh
  overflow.catala_en
  (package catala))
 (action
  (run sh run.sh c 123 "An integer is too large for this computation")))

(rule
 (alias runtest)
 (enabled_if %{bin-available:javac})
 (deps
  run.sh
  overflow.catala_en
  (package catala))
 (action
  (run sh run.sh java 123 "an integer is too large for this computation")))

(rule
 (alias runtest)
 (enabled_if %{bin-available:python3})
 (deps
  run.sh
  overflow.catala_en
  (package catala))
 (action
  (run sh run.sh python 0 "18446744073709551614 days")))
